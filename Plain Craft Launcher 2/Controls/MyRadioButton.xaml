<Border x:Name="PanBack" x:Class="MyRadioButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL"
             HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource ColorBrushSemiTransparent}" BorderThickness="{StaticResource GlassBorderThickness}" BorderBrush="{StaticResource GlassControlStroke}" CornerRadius="{StaticResource GlassControlCorner}" MinHeight="27" MaxHeight="27">
    <Grid>
    <local:CaumcGlassSurface x:Name="GlassFace" Material="Control" Radius="{StaticResource GlassControlRadius}" />
    <Border Background="{Binding Background, ElementName=PanBack}" CornerRadius="{StaticResource GlassControlCorner}" IsHitTestVisible="False" />
    <StackPanel Orientation="Horizontal">
        <Path x:Name="ShapeLogo" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Margin="12,0,0,0" Stretch="Uniform" Fill="{DynamicResource ColorBrush2}" MaxHeight="16" MaxWidth="16" VerticalAlignment="Center" />
        <TextBlock x:Name="LabText" VerticalAlignment="Center" Grid.Column="1" Foreground="{DynamicResource ColorBrush1}" Margin="8,0,12,0" Grid.ColumnSpan="2" SnapsToDevicePixels="False" UseLayoutRounding="False" />
    </StackPanel>
    </Grid>
</Border>
