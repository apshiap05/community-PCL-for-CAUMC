<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    x:Name="PanBack" mc:Ignorable="d" x:Class="MyExtraTextButton"
    RenderTransformOrigin="0.5,0.5" Height="52" Margin="20" Cursor="Hand">
    <Grid.RenderTransform>
        <ScaleTransform ScaleX="0" ScaleY="0" />
    </Grid.RenderTransform>
    <Border x:Name="PanClick" BorderThickness="0.001" Background="{StaticResource ColorBrushSemiTransparent}" 
            CornerRadius="{StaticResource GlassControlCorner}"/>
    <Grid x:Name="PanScale" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" Margin="0,10,0,0">
        <Grid.RenderTransform>
            <ScaleTransform />
        </Grid.RenderTransform>
        <Border x:Name="PanColor" BorderThickness="{StaticResource GlassBorderThickness}" BorderBrush="{StaticResource GlassControlStroke}" Background="{StaticResource GlassPrimaryFill}"
                CornerRadius="{StaticResource GlassControlCorner}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.12" />
            </Border.Effect>
            <Grid><local:CaumcGlassSurface Material="Control" Radius="{StaticResource GlassControlRadius}" />
                <Border Background="{Binding Background, ElementName=PanColor}" CornerRadius="{StaticResource GlassControlCorner}" /></Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="20,0" SnapsToDevicePixels="False" UseLayoutRounding="False">
            <Path x:Name="Path" Stretch="Uniform" Margin="2,12,0,12" Fill="White" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <ScaleTransform />
                </Path.RenderTransform>
            </Path>
            <TextBlock x:Name="LabText" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" FontSize="16"
                       Margin="12,0,0,0.8" />
        </StackPanel>
    </Grid>
</Grid>
