<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL"
    x:Class="PageSpeedRight" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="18,16">
                    <TextBlock Text="任务中心" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="下载、安装和导入进度都在这里。" Margin="0,6,0,12" />
                    <WrapPanel>
                        <local:MyButton x:Name="FilterAll" Text="全部" Height="32" Width="82" Margin="0,0,8,0" ColorType="Highlight" />
                        <local:MyButton x:Name="FilterActive" Text="进行中" Height="32" Width="82" Margin="0,0,8,0" />
                        <local:MyButton x:Name="FilterPending" Text="待处理" Height="32" Width="82" Margin="0,0,8,0" />
                        <local:MyButton x:Name="FilterHistory" Text="已结束" Height="32" Width="82" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <StackPanel x:Name="PanMain" />
            <local:MyCard x:Name="EmptyCard">
                <TextBlock x:Name="EmptyText" Text="还没有任务" Margin="18" FontSize="15" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
